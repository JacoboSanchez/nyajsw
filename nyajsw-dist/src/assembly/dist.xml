<?xml version="1.0" encoding="UTF-8"?>
<!-- The distribution zip (plan P8.1):
     nyajsw-<version>/
       nyajsw.jar           the wrapper with JNA (shaded)
       nyajsw-agent.jar     the agent; the wrapper looks for it beside nyajsw.jar
       bin/*.bat            the scripts, named as YAJSW's
       conf/wrapper.conf    the commented template
       docs/*.md            the guides and the compatibility matrix
       LICENSE, README.md, THIRD-PARTY.txt -->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 https://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>dist</id>
    <formats>
        <format>zip</format>
    </formats>
    <baseDirectory>${nyajsw.dist.name}</baseDirectory>

    <files>
        <file>
            <source>${project.build.directory}/nyajsw.jar</source>
        </file>
        <file>
            <source>${project.basedir}/../LICENSE</source>
        </file>
        <file>
            <source>${project.basedir}/../README.md</source>
        </file>
        <file>
            <!-- Filtered for the JNA version; nothing under src/main/dist is, since the
                 template's variable references must stay as they are. -->
            <source>src/assembly/THIRD-PARTY.txt</source>
            <filtered>true</filtered>
        </file>
    </files>

    <fileSets>
        <fileSet>
            <directory>src/main/dist</directory>
            <outputDirectory>/</outputDirectory>
            <excludes>
                <exclude>bin/**</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <!-- cmd.exe needs CRLF, however the working tree was checked out. -->
            <directory>src/main/dist/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <lineEnding>crlf</lineEnding>
        </fileSet>
        <fileSet>
            <!-- All of them, the plan included, so that the documents' links resolve. -->
            <directory>${project.basedir}/../docs</directory>
            <outputDirectory>docs</outputDirectory>
            <includes>
                <include>*.md</include>
            </includes>
        </fileSet>
    </fileSets>

    <dependencySets>
        <dependencySet>
            <includes>
                <include>io.jsl.nyajsw:nyajsw-agent</include>
            </includes>
            <useProjectArtifact>false</useProjectArtifact>
            <useTransitiveFiltering>false</useTransitiveFiltering>
            <outputDirectory>/</outputDirectory>
            <outputFileNameMapping>nyajsw-agent.jar</outputFileNameMapping>
        </dependencySet>
    </dependencySets>
</assembly>
